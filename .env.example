# Copy to .env and adjust. Every value has a default; only set what you need.

# Where downloads/outputs, analysis cache and downloaded model weights live.
# Relative paths are resolved from the repository root.
MEDIA_DIR=media
CACHE_DIR=cache
MODELS_DIR=models

# ffmpeg with hardware encoders. On Linux point these at the NVENC-enabled build
# installed by scripts/setup-linux.sh; on macOS Homebrew's ffmpeg already has VideoToolbox.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# auto | faster-whisper | mlx | cpu
TRANSCRIBE_BACKEND=auto
# auto | nvenc | videotoolbox | x264
ENCODER=auto
# h264 | hevc
VIDEO_CODEC=h264

WHISPER_MODEL=large-v3-turbo
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
SEPARATION_MODEL=UVR-MDX-NET-Voc_FT.onnx

OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b
VISION_MODEL=qwen3.5:4b

MAX_CONCURRENT_JOBS=1
